# StudioDesk configuration. Copy to `.env` and fill in real values locally.
# Never commit `.env`. All external integration keys are optional in Milestone 1.

# --- Application ---------------------------------------------------------
# One of: dev, test, prod
APP_ENV=dev
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Reported by GET /health (defaults to the package version)
APP_VERSION=0.1.0
# Maximum accepted request body size in bytes
MAX_REQUEST_BYTES=64000

# --- LLM -----------------------------------------------------------------
# One of: groq (default, free tier), anthropic (optional)
LLM_PROVIDER=groq
# Leave empty for the provider default: groq -> openai/gpt-oss-120b,
# anthropic -> claude-sonnet-5-5
LLM_MODEL=
# Key for the selected provider; the other one may stay empty
GROQ_API_KEY=gsk_your-groq-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Sampling temperature for Groq (keep it low: 0-0.2)
LLM_TEMPERATURE=0.1
# Groq only: reasoning effort of the reasoning model: low, medium or high
LLM_REASONING_EFFORT=medium
# Anthropic only: output effort (low, medium, high, xhigh or max)
LLM_EFFORT=medium
# Upper bound on generated tokens per LLM call (includes reasoning tokens)
LLM_MAX_TOKENS=4096
# Per-request timeout in seconds
LLM_TIMEOUT_S=30
# Overall budget per LLM call including retries; no retry starts after it is spent
LLM_REQUEST_DEADLINE_S=75
# Process-wide cap on concurrent LLM calls. A call waits at most LLM_CONCURRENCY_WAIT_S
# for a slot, else the API returns 503 with Retry-After: LLM_BUSY_RETRY_AFTER_S.
LLM_MAX_CONCURRENCY=4
LLM_CONCURRENCY_WAIT_S=2
LLM_BUSY_RETRY_AFTER_S=5
# Retries of a transient LLM failure, and the longest wait (Retry-After or backoff) before
# one. A longer requested wait fails fast with 503 + Retry-After instead of blocking.
LLM_MAX_RETRIES=1
LLM_MAX_RETRY_WAIT_S=10
# Anthropic only: server-side refusal fallback (beta server-side-fallback-2026-07-01)
LLM_REFUSAL_FALLBACK=true

# --- Agent (answers, duplicates, routing) -----------------------------------
# Chunks retrieved as context for POST /ask
ANSWER_TOP_K=6
# Bug reports retrieved as duplicate candidates for POST /bugs/check
DUP_SEARCH_K=5
# Cosine score from which a bug report is sent to the LLM as a duplicate candidate
DUP_CANDIDATE_THRESHOLD=0.48
# Cosine score from which an LLM-confirmed candidate is reported as "duplicate"
DUP_AUTO_THRESHOLD=0.70
# Neighbours voting on the predicted component and severity
ROUTING_K=7

# --- Confirmed actions -----------------------------------------------------
# Seconds a proposed action (e.g. filing an issue) can be confirmed
ACTION_TTL_S=900
# Maximum proposals held in memory at once
ACTION_MAX_PENDING=1000
# Kill switch for filing GitHub issues. Unset = enabled in dev/test, DISABLED in prod
# (there is no auth yet); set ACTIONS_ENABLED=true to allow filing in prod deliberately.
# When disabled, /bugs/check still returns the issue preview without a confirm token.
# ACTIONS_ENABLED=
# Maximum issues filed per UTC day (per process); confirms beyond it get 503.
ACTIONS_MAX_PER_DAY=20

# --- Qdrant (vector store) -----------------------------------------------
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=studiodesk
# Must be https:// (plain http is accepted only for localhost). Leave QDRANT_URL empty to
# use an embedded local store at QDRANT_LOCAL_PATH instead (":memory:" for in-memory).
QDRANT_TIMEOUT_S=30
# Points per upsert request (independent of EMBEDDING_BATCH_SIZE)
QDRANT_UPSERT_BATCH_SIZE=32
QDRANT_LOCAL_PATH=.qdrant_data

# --- Embeddings ----------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Pinned Hugging Face commit of EMBEDDING_MODEL (40-char sha)
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
# One of: cpu, cuda, mps
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64

# --- Search API ----------------------------------------------------------
# Per-client-IP limit for POST /search, as <count>/<second|minute|hour|day>
SEARCH_RATE_LIMIT=30/minute
# Per-client-IP limits for POST /ask, POST /bugs/check and POST /actions/*
ASK_RATE_LIMIT=10/minute
BUGS_RATE_LIMIT=10/minute
ACTIONS_RATE_LIMIT=5/minute
# Reverse proxies whose X-Forwarded-For is trusted for client-IP resolution, as
# comma-separated IPs/CIDRs. Empty = trust none (rate limit on the direct peer IP).
# On Railway/Render the app sits behind the platform's edge proxy, so without this every
# request appears to come from the proxy and all clients share one bucket. Set it to the
# proxy address range your platform documents (verify it; never use 0.0.0.0/0).
TRUSTED_PROXY_IPS=

# --- GitHub Issues -------------------------------------------------------
# Use a fine-grained personal access token scoped to a SINGLE repository,
# with only "Issues: Read and write" permission. No other scopes.
GITHUB_TOKEN=github_pat_your-token-here
# Target repository as owner/name
GITHUB_REPO=your-org/your-repo
GITHUB_TIMEOUT_S=15

# --- Slack ---------------------------------------------------------------
# Incoming webhook URL for the alerts channel, e.g. https://hooks.slack.com/services/...
# It is a secret. Empty = Slack disabled: alerts are logged as "skipped".
SLACK_WEBHOOK_URL=
SLACK_TIMEOUT_S=10

# --- ElevenLabs (voice) --------------------------------------------------
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=your-agent-id

# --- Evals (local only) --------------------------------------------------
# Read only by `python -m evals.run` (never by the app or CI; `--offline` ignores them).
# Groundedness judge model (same provider as LLM_PROVIDER; empty = provider default)
EVAL_JUDGE_MODEL=qwen/qwen3.8-27b
# Client-side throttle for live eval LLM calls (requests per minute, free-tier friendly)
EVAL_MAX_RPM=20

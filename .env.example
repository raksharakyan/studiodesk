# StudioDesk configuration. Copy to `.env` and fill in real values locally.
# Never commit `.env`. All external integration keys are optional in Milestone 1.

# --- Application ---------------------------------------------------------
# One of: dev, test, prod
APP_ENV=dev
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Reported by GET /health (defaults to the package version)
APP_VERSION=0.1.0
# Maximum accepted request body size in bytes
MAX_REQUEST_BYTES=64000

# --- LLM -----------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Qdrant (vector store) -----------------------------------------------
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=studiodesk
# Must be https:// (plain http is accepted only for localhost). Leave QDRANT_URL empty to
# use an embedded local store at QDRANT_LOCAL_PATH instead (":memory:" for in-memory).
QDRANT_TIMEOUT_S=10
QDRANT_LOCAL_PATH=.qdrant_data

# --- Embeddings ----------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Pinned Hugging Face commit of EMBEDDING_MODEL (40-char sha)
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
# One of: cpu, cuda, mps
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64

# --- Search API ----------------------------------------------------------
# Per-client-IP limit for POST /search, as <count>/<second|minute|hour|day>
SEARCH_RATE_LIMIT=30/minute

# --- GitHub Issues -------------------------------------------------------
# Use a fine-grained personal access token scoped to a SINGLE repository,
# with only "Issues: Read and write" permission. No other scopes.
GITHUB_TOKEN=github_pat_your-token-here
# Target repository as owner/name
GITHUB_REPO=your-org/your-repo

# --- Slack ---------------------------------------------------------------
# Incoming webhook URL for the alerts channel
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- ElevenLabs (voice) --------------------------------------------------
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=your-agent-id

# StudioDesk configuration. Copy to `.env` and fill in real values locally.
# Never commit `.env`. All external integration keys are optional in Milestone 1.

# --- Application ---------------------------------------------------------
# One of: dev, test, prod
APP_ENV=dev
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Reported by GET /health (defaults to the package version)
APP_VERSION=0.1.0
# Maximum accepted request body size in bytes
MAX_REQUEST_BYTES=64000

# --- LLM -----------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Qdrant (vector store) -----------------------------------------------
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=studiodesk
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- GitHub Issues -------------------------------------------------------
# Use a fine-grained personal access token scoped to a SINGLE repository,
# with only "Issues: Read and write" permission. No other scopes.
GITHUB_TOKEN=github_pat_your-token-here
# Target repository as owner/name
GITHUB_REPO=your-org/your-repo

# --- Slack ---------------------------------------------------------------
# Incoming webhook URL for the alerts channel
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- ElevenLabs (voice) --------------------------------------------------
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=your-agent-id
